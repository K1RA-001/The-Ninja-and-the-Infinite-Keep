[node name="Menu" type="Node2D"]
script = ExtResource("1")

[node name="Backdrop" type="ColorRect" parent="."]
z_index = -100
offset_left = -1200.0
offset_top = -1200.0
offset_right = 1200.0
offset_bottom = 1200.0
color = Color(0.055, 0.067, 0.105, 1)

[node name="CastleBackdrop" type="Node2D" parent="."]
z_index = -90
script = ExtResource("2")

[node name="UI" type="CanvasLayer" parent="."]

[node name="Center" type="CenterContainer" parent="UI"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MenuCard" type="PanelContainer" parent="UI/Center"]
custom_minimum_size = Vector2(470, 410)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_menu")

[node name="Stack" type="VBoxContainer" parent="UI/Center/MenuCard"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="UI/Center/MenuCard/Stack"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.7, 0.39, 1)
theme_override_font_sizes/font_size = 38
text = "NINJA KEEP"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="UI/Center/MenuCard/Stack"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.66, 0.55, 1)
theme_override_font_sizes/font_size = 17
text = "A CLIMB THAT NEVER ENDS"
horizontal_alignment = 1

[node name="Gap" type="Control" parent="UI/Center/MenuCard/Stack"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2

[node name="Start" type="Button" parent="UI/Center/MenuCard/Stack"]
custom_minimum_size = Vector2(300, 52)
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.86, 0.69, 1)
theme_override_font_sizes/font_size = 21
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
theme_override_styles/hover = SubResource("StyleBoxFlat_button")
text = "BEGIN THE CLIMB"

[node name="Controls" type="Button" parent="UI/Center/MenuCard/Stack"]
custom_minimum_size = Vector2(300, 48)
layout_mode = 2
theme_override_colors/font_color = Color(0.84, 0.79, 0.68, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
theme_override_styles/hover = SubResource("StyleBoxFlat_button")
text = "CONTROLS"

[node name="Quit" type="Button" parent="UI/Center/MenuCard/Stack"]
custom_minimum_size = Vector2(300, 44)
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.59, 0.49, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
theme_override_styles/hover = SubResource("StyleBoxFlat_button")
text = "QUIT"

[node name="Footer" type="Label" parent="UI/Center/MenuCard/Stack"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.53, 0.49, 1)
theme_override_font_sizes/font_size = 13
text = "The keep gets kinder when you keep trying."
horizontal_alignment = 1

[node name="ControlsCard" type="PanelContainer" parent="UI"]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -230.0
offset_top = -150.0
offset_right = 230.0
offset_bottom = 150.0
theme_override_styles/panel = SubResource("StyleBoxFlat_menu")

[node name="ControlsStack" type="VBoxContainer" parent="UI/ControlsCard"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="ControlsTitle" type="Label" parent="UI/ControlsCard/ControlsStack"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.7, 0.39, 1)
theme_override_font_sizes/font_size = 27
text = "HOW TO CLIMB"
horizontal_alignment = 1

[node name="ControlsText" type="Label" parent="UI/ControlsCard/ControlsStack"]
layout_mode = 2
theme_override_colors/font_color = Color(0.87, 0.83, 0.72, 1)
theme_override_font_sizes/font_size = 18
text = "← / → or A / D     Move\n↑ / SPACE / W     Jump\n\nKeep moving before the keep scrolls past.\nAvoid the spikes. Try again."
horizontal_alignment = 1

[node name="CloseControls" type="Button" parent="UI/ControlsCard/ControlsStack"]
custom_minimum_size = Vector2(250, 46)
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.86, 0.69, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
theme_override_styles/hover = SubResource("StyleBoxFlat_button")
text = "BACK"

[connection signal="pressed" from="UI/Center/MenuCard/Stack/Start" to="." method="_on_start_pressed"]
[connection signal="pressed" from="UI/Center/MenuCard/Stack/Controls" to="." method="_on_controls_pressed"]
[connection signal="pressed" from="UI/Center/MenuCard/Stack/Quit" to="." method="_on_quit_pressed"]
[connection signal="pressed" from="UI/ControlsCard/ControlsStack/CloseControls" to="." method="_on_close_controls_pressed"]
